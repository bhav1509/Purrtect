{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "key": "",
  "default_locale": "en",
  "icons": {
    "16": "mascots/icon-16.png",
    "32": "mascots/icon-32.png",
    "48": "mascots/icon-48.png",
    "128": "mascots/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "mascots/icon-16.png",
      "32": "mascots/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "ui/settings.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*",
    "https://purrtect-api-fzrq3bgblq-el.a.run.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "rules.js",
        "lib/store.js",
        "ui/core.js",
        "ui/verdict-card.js",
        "ui/recovery-panel.js",
        "ui/confirm-send.js",
        "ui/badge.js",
        "ui/click-warning.js",
        "content/site.js",
        "content/link-card.js",
        "content/cursor-cat.js",
        "content/gmail.js"
      ],
      "css": [
        "ui/ui.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "rules.js",
        "lib/store.js",
        "ui/core.js",
        "ui/verdict-card.js",
        "ui/recovery-panel.js",
        "ui/confirm-send.js",
        "ui/badge.js",
        "ui/click-warning.js",
        "content/site.js",
        "content/link-card.js",
        "content/cursor-cat.js",
        "content/whatsapp.js"
      ],
      "css": [
        "ui/ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mascots/*/*.png",
        "mascots/cat/sheet.json",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://project-1e762a2b-4a0e-4e91-981.web.app/*",
      "https://project-1e762a2b-4a0e-4e91-981.firebaseapp.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
