{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "mascots/cat/idle.png",
    "48": "mascots/cat/idle.png",
    "128": "mascots/cat/idle.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "ui/settings.html",
    "default_icon": "mascots/cat/idle.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*",
    "https://purrtect-api-fzrq3bgblq-el.a.run.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "rules.js",
        "lib/store.js",
        "ui/core.js",
        "ui/verdict-card.js",
        "ui/recovery-panel.js",
        "ui/badge.js",
        "ui/click-warning.js",
        "content/site.js",
        "content/gmail.js"
      ],
      "css": [
        "ui/ui.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "rules.js",
        "lib/store.js",
        "ui/core.js",
        "ui/verdict-card.js",
        "ui/recovery-panel.js",
        "ui/badge.js",
        "ui/click-warning.js",
        "content/site.js",
        "content/whatsapp.js"
      ],
      "css": [
        "ui/ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mascots/*/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
