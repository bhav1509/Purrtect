{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "cloudbuild.yaml", "firebase-debug.log", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "purrtect-api", "region": "asia-south1" }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  }
}
